# SQLite adatbázis (Prisma). Prodban cserélhető PostgreSQL-re.
DATABASE_URL="file:./dev.db"

# Munkamenet-süti aláíró kulcs. Prodban KÖTELEZŐ erős, egyedi titok!
SESSION_SECRET="fejlesztesi-titok-csereld-le-prodban"

# Az alkalmazás publikus URL-je — az e-mailekben szereplő linkekhez.
APP_URL="http://localhost:3000"

# Az évforduló-emlékeztető cron végpont titka:
#   curl -H "Authorization: Bearer <titok>" $APP_URL/api/cron/emlekeztetok
CRON_SECRET="cron-titok-csereld-le-prodban"

# Helykereső (geokódolás). Alapértelmezés: a nyilvános OpenStreetMap Nominatim.
# Nagy forgalomnál saját Nominatim/Photon példány ajánlott (az OSM szolgáltatása
# másodpercenként 1 kérést enged) — akkor ide írd a saját példány címét.
# GEOCODER_URL="https://nominatim.openstreetmap.org"

# SMTP — opcionális. Ha nincs beállítva, az e-mailek nem mennek ki, csak a
# moderációs felület „E-mail napló" fülén jelennek meg (fejlesztői mód).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="L’mur <no-reply@lmur.hu>"
